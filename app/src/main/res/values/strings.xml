    <string name="ob1_title">Scrolling never ends</string>
    <string name="ob1_body">Feeds are made to keep you in. Minutes turn into hours before you notice.</string>
    <string name="ob2_title">So we slow the internet</string>
    <string name="ob2_body">After a long scroll, Slow Down makes your connection crawl. Videos stall and feeds load slowly.</string>
    <string name="ob3_title">You put the phone down</string>
    <string name="ob3_body">When scrolling stops being fun, you stop. Step away and the speed comes back.</string>
